{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // This repo is NOT a uniform workspace monorepo. There are four distinct
  // project roots with different dependency sets:
  //   - "."                                    root app: client/ server/ lib/ shared/ scripts/
  //   - "packages/*"                           the real bun workspaces (vector-cli/engine/wasm)
  //   - "vscode-extension/hypercanvas-preview" own package.json + esbuild + tsconfig
  //   - "vscode-extension/hypercanvas-code-server"
  // templates/** and server/docker/** are standalone scaffolds and must never be
  // analyzed (nextjs-tamagui is its own nested monorepo and explodes).
  // No vite plugin drives the main app (built by scripts/build-client.ts) and tests
  // run under `bun test` (not vitest/jest), so test entries are declared explicitly.
  // Config files (drizzle/tailwind/postcss), server/main.ts, esbuild.js and each
  // package's main/bin are auto-detected by knip from package.json + known plugins —
  // do NOT list them as explicit entries (knip flags them as redundant).
  //
  // Two "Add entry / refine project files" hints remain (root + hypercanvas-preview).
  // These are knip's high-unused-file-ratio heuristic, NOT a misconfiguration: the
  // repo genuinely has ~58 unused files / 491 unused exports. Silencing them would
  // require adding fake entry points that mask real dead code — out of scope here
  // (HYP-416 is config SETUP; the unused-code cleanup is follow-up work).
  "ignore": [
    "templates/**",
    "server/docker/**",
    // Local runtime junk that lands inside the checkout. Both dirs ARE gitignored,
    // but the contents are themselves git repos/worktrees (nested .git), which breaks
    // knip's gitignore chain — files inside then match the root entry globs
    // (**/*.test.ts, **/__tests__/**) and fail the run with unlisted-dependency
    // errors from foreign projects. HYP-653.
    // - cloned-projects/: user projects cloned at runtime (server/routes/project-creation.ts)
    // - .claude/worktrees/, .ralphex/worktrees/: agent-created git worktrees
    // (same dir set bunfig.toml pathIgnorePatterns excludes from `bun test`)
    "cloned-projects/**",
    ".claude/worktrees/**",
    ".ralphex/worktrees/**",
    // Runtime-loaded, not statically imported — knip can't see these refs:
    // - iframe-console-capture.js: read via Bun.file('./shared/scripts/...') in
    //   server/main.ts, served at /__hypercanvas/iframe-console-capture.js, and
    //   bundled as an esbuild entryPoint in the extension (esbuild.js).
    "shared/scripts/iframe-console-capture.js",
    // - process-shim.js / chrome-detection.js: read via readFileSync in
    //   server/proxy/hypercanvas-scripts.ts and served at /__hypercanvas/*.js for
    //   SaaS-hosted Remix previews (HYP-758). Same runtime-load case — knip can't
    //   see the readFileSync ref. Their behavioral twins live inline in the
    //   extension's PreviewProxy.ts (SYNC-noted in each source).
    "shared/scripts/process-shim.js",
    "shared/scripts/chrome-detection.js",
    // DOUBTFUL — pending CTO decision (HYP-489 follow-up ticket). NOT confirmed
    // dead; do not delete without a product call:
    // (useNetworkAwarePolling was here — now consumed by useDiagnosticSync, HYP-518.)
    // (PushPopover/** was here — dropped, superseded by SourceControlSection, HYP-517.)
    // (WorkspacePicker was here — now wired into Projects.tsx, HYP-516.)
  ],
  // -------------------------------------------------------------------------
  // HYP-432: silence three knip false-positive categories WITHOUT hiding real
  // dead code. (HYP-416's ~491 genuine dead exports remain out of scope.)
  //
  // Category 1 — cross-workspace @lib/ / @shared/ aliases — needs NO config here.
  // The vscode-extension webview bundles import root lib/shared via esbuild
  // @lib//@shared/ aliases, AND the extension tsconfig
  // (vscode-extension/hypercanvas-preview/tsconfig.json) carries the matching
  // compilerOptions.paths. knip resolves TS path aliases from tsconfig, so it
  // already follows those imports into the root workspace: of 151 distinct
  // lib/shared symbols imported by the extension, 146 are correctly seen as used.
  // The 5 still-flagged are NOT alias misses — they are dead re-export chains
  // (ext/src/types.ts re-exports a few @lib/types symbols nobody downstream
  // consumes; the `callAI` re-export in lib/component-scanner; the unused
  // CssSystemId convenience re-export in lib/style-write/types.ts). Those stay
  // reported and are the spot-check that proves we don't hide dead code.
  // Do NOT "fix" category 1 with knip `paths`/compilers — it isn't broken,
  // and no upstream knip patch is needed.
  //
  // Categories 2 & 3 are handled with PRECISE per-export `@public` JSDoc tags
  // (knip's `tags` config below + tags in the source), NOT broad file ignores —
  // `ignoreExportsUsedInFile` was rejected because it hid 97 unrelated legit
  // "over-export / de-export me" findings while suppressing none of the targets,
  // and `entry`-ing a vocabulary file would also hide the genuinely-dead orphans
  // that co-live in it (AIMessageRole, …).
  // `tags: ["-public"]` => any export carrying a `@public` JSDoc tag is EXCLUDED
  // from the report (treated as intentionally-public surface, i.e. "used").
  // Used for BOTH category 3 (aggregate-catalog consts in shared/ai-agent-tools.ts)
  // and category 2 (public vocabulary types in lib/style-read/types.ts +
  // lib/style-write/types.ts). Per-export `@public` is deliberate over a broad
  // `ignoreExportsUsedInFile` (which globally suppressed ~280 legit "de-export me"
  // type findings and ~97 value findings — the exact signal HYP-423/#276 relies on)
  // and over `entry` on the file (which would also hide the genuinely-dead orphan
  // types co-located in style-read/types.ts: ComponentPropMapper, CssSystemDescriptor).
  "tags": ["-public"],
  "workspaces": {
    ".": {
      "entry": [
        "client/App.tsx",
        "client/__canvas_preview__.tsx",
        "client/main.tsx",
        "server/index.ts",
        "scripts/*.{ts,cjs}",
        // Self-declared public-API library barrels (each file's own header marks it
        // a "Public API" / "@packageDocumentation" / "abstraction layer"). These are
        // deliberate, consumed-cross-workspace surfaces — canvas-engine via the
        // ../canvas-engine barrel (38 importers incl. the VS Code extension webviews),
        // lib/platform via @/lib/platform (19 importers), lib/testing via ../lib/testing
        // (server test-gen routes). Treating the barrel as an entry keeps the curated
        // public surface intact instead of churning every re-export into a subpath
        // import. Incidental (non-self-declared) barrels are NOT entried — their dead
        // re-exports are trimmed instead. HYP-489.
        "client/lib/canvas-engine/index.ts",
        "client/lib/platform/index.ts",
        "lib/testing/index.ts",
        // CLI entry point, run directly: `bun run lib/testing/cli/generate-tests.ts`.
        "lib/testing/cli/generate-tests.ts",
        // Visual-verification public surface (unstyled-render detector, HYP-733).
        // Consumed by agent proof scripts (scripts/*.tsx, which knip's
        // `scripts/*.{ts,cjs}` entry glob does not see) and, later, the e2e
        // blank-webview guard — so the barrel is entried to keep the curated API.
        "lib/visual-verify/index.ts",
        // Node-only headless-Chrome capture guard — kept OFF the browser-safe
        // barrel (it imports playwright-core) and only referenced by the
        // knip-invisible scripts/*.tsx proof path, so it is entried directly.
        "lib/visual-verify/capture-and-verify.ts",
        // B0 write-transaction public surface (style-editing master spec §9.1, HYP-722
        // T1a). The lib-level snapshot/journal/rollback saga that brackets every style
        // write. Two curated barrels: `index.ts` is the BROWSER-SAFE surface (no
        // node:crypto / NodeFileIO — the serverless/OPFS realm imports it and injects its
        // own FileIO + hasher); `index.node.ts` adds the Node-realm pieces
        // (`runStyleWriteTransaction`, the node:crypto `hashContent`) for the SaaS update
        // routes + the VS Code AstBridge, which wire the transaction as the convergence
        // task lands (spec §9.1 "realms differ ONLY in the FS transport beneath one shared
        // lib/ writeId/rollback API"). Both are entried to keep the curated public surface
        // intact rather than churn the future callsites into subpath imports.
        "lib/style-write/transaction/index.ts",
        "lib/style-write/transaction/index.node.ts",
        "**/*.test.{ts,tsx}",
        // `bun test --isolate` (package.json "test") also collects *.spec.{ts,tsx}
        // (e.g. client/lib/utils.spec.ts). Without this glob knip flags the spec
        // file as an unused file and its imports as dead — a config gap, not dead code.
        "**/*.spec.{ts,tsx}",
        "**/__tests__/**/*.{ts,tsx}",
        // shadcn/ui primitives live in client/components/ui/**. shadcn is a
        // "copy the component source into your repo" library: the full primitive
        // set is scaffolded up front and consumed incrementally. Unused primitives
        // (and their paired @radix-ui/* devDeps) are intentional library surface to
        // be wired into the UI later, NOT dead code — treat each as an entry so knip
        // stops flagging the not-yet-used ones (and their deps) while still reporting
        // genuinely-broken imports inside them. HYP-489 / matches HYP-418 judgment.
        "client/components/ui/**/*.{ts,tsx}",
      ],
      "project": [
        "client/**/*.{ts,tsx}",
        "server/**/*.ts",
        "lib/**/*.ts",
        "shared/**/*.{ts,tsx,js}",
        "scripts/**/*.{ts,cjs}",
        "test/**/*.ts",
      ],
      // @playwright/mcp is loaded at runtime via a filesystem path
      // (server/services/playwright-mcp.ts resolves node_modules/@playwright/mcp/cli.js),
      // not a static import — knip can't see it.
      //
      // @swc/core: not imported anywhere in source/build (build is Bun.build + esbuild,
      //   lint oxlint, typecheck tsgo). It is deliberately listed in
      //   package.json "trustedDependencies" so bun permits its postinstall — an
      //   intentional allowlist entry, not a code import. Removing it is a separate
      //   call (touches trustedDependencies) tracked for CTO; keep silenced here.
      // @hookform/resolvers: the validation-adapter that pairs with react-hook-form,
      //   used by the scaffolded shadcn form primitive (client/components/ui/form.tsx,
      //   an entry). Intentional UI-library surface to wire up when a real form lands,
      //   same status as the other shadcn-paired deps that the ui/** entry auto-resolves.
      // bun-plugin-tailwind: referenced by name as a capability signal for USER projects
      //   (lib/preview-generator/framework-routing.ts checks deps['bun-plugin-tailwind'])
      //   and pulls in the `bun` npm peer that scripts/fix-bun-shim.ts repairs in
      //   postinstall. Not a static module import in this repo, so knip can't see the
      //   dependency — keep it declared and silenced.
      // playwright-core: imported (lazily) by lib/visual-verify/capture-and-verify.ts
      //   for the headless-Chrome style-presence proof guard (HYP-733). It is the
      //   library half of the same transitive Playwright copy pinned by @playwright/mcp
      //   (1.59.0-alpha-…); declaring it directly would conflict with that pin, so we
      //   rely on the transitive copy and silence the unlisted-dependency flag — same
      //   rationale as the `playwright` binary below.
      "ignoreDependencies": [
        "@playwright/mcp",
        "playwright-core",
        "@swc/core",
        "@hookform/resolvers",
        "bun-plugin-tailwind",
      ],
      // The `playwright` binary (postinstall: `npx playwright install chromium`) is
      // provided transitively by @playwright/mcp, which pins a prerelease
      // (1.59.0-alpha-…). Declaring `playwright` directly would conflict with that pin,
      // so we rely on the transitive copy and silence the unlisted-binary flag.
      "ignoreBinaries": ["playwright"],
    },
    "packages/*": {
      // Each package's entry (src/index.ts or src/context.ts via `main`, bin/vecli.ts
      // via `bin`) is inferred from its own package.json. Only declare test files.
      // .tsx is included for vector-cli's ink TUI components (src/tui/*.tsx) and their
      // ink-testing-library specs (test/*.test.tsx).
      "entry": ["**/*.test.{ts,tsx}"],
      "project": "src/**/*.{ts,tsx}",
      // vector-cli declares vector-wasm (workspace:*) but doesn't import it from its own
      // src/. It's a runtime requirement reached transitively: vector-cli -> vector-engine
      // -> `import { MockPathOps } from 'vector-wasm'` (register-all.ts, a value import).
      // vecli executes path-ops (boolean/offset) which need the backend at runtime, so the
      // declaration is load-bearing — knip's per-package src/ scan can't see it.
      "ignoreDependencies": ["vector-wasm"],
    },
    "vscode-extension/hypercanvas-preview": {
      "entry": [
        "src/webview/index.tsx",
        "src/webview-left/index.tsx",
        "src/webview-right/index.tsx",
        "src/webview-preview-panel/index.tsx",
        "src/webview-ai-chat/index.tsx",
        "src/services/scripts/iframe-interaction.ts",
        "src/services/scripts/iframe-error-detection.ts",
        // src/stubs/** are build-time replacements wired up by esbuild's alias
        // onResolve plugin (esbuild.js maps @/components/..., authFetch, monaco,
        // etc. to these files). They are never statically imported, so knip's
        // static analysis can't see the reference — declare them as entries so the
        // build-invisible stubs aren't flagged as unused files/exports.
        "src/stubs/**/*.{ts,tsx}",
        "src/__tests__/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
      ],
      "project": "src/**/*.{ts,tsx}",
      // These are NOT used directly by src/**, but the webview bundles import SaaS code
      // via the `@/` (-> ../../client) and `@lib/` (-> ../../lib) esbuild aliases, which
      // DO use them. knip's per-workspace project glob can't follow cross-workspace
      // aliases, so it false-flags them. They are required by the bundle and must stay.
      "ignoreDependencies": [
        "@anthropic-ai/sdk",
        "@babel/generator",
        "@babel/parser",
        "react-resizable-panels",
        "recast",
        "@radix-ui/react-dialog",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-slot",
        "@radix-ui/react-tooltip",
        "class-variance-authority",
        "react-markdown",
        "tailwind-merge",
        "zustand",
      ],
    },
    "vscode-extension/hypercanvas-code-server": {
      "entry": ["**/*.test.ts"],
      "project": "src/**/*.ts",
    },
  },
}
