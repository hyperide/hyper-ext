.claude/settings.local.json

# SOPS decrypted secrets (never commit!)
*.dec.yaml
k8s/base/secrets.yaml

# Monaco Editor pre-built workers
public/monaco-workers/

# VSCode extension build artifacts
vscode-extension/hypercanvas-preview/out

# Extension-managed runtime files (auto-generated by the canvas-preview generator
# in lib/preview-generator). NOTE: client/__canvas_preview__.tsx is deliberately
# TRACKED here — hyperide self-hosts inside HyperIDE and ships it as a build
# entrypoint (scripts/build-client.ts), so the plain registry at client/ is NOT
# ignored. Everything else the generator emits is scratch and must never be committed,
# including the src/ fallback registry it writes when getPreviewFilePath() can't detect
# the real entry (e.g. a linked worktree where ensureGitExclude can't touch .git/info).
.hyperide/
src/__canvas_preview__.tsx
**/__canvas_preview_standalone__.tsx
**/__canvas_samples__.tsx
**/test-preview.tsx
**/test-preview.astro
**/test-preview/
vscode-extension/hypercanvas-code-server/out
vscode-extension/hypercanvas-preview/bun.lock
vscode-extension/hypercanvas-preview/bun.lockb
*.vsix

# Compiled JS alongside TS sources (esbuild/tsc artifacts)
shared/*.js
shared/*.js.map
client/components/ui/*.js
client/components/ui/*.js.map
client/lib/*.js
client/lib/*.js.map
.tsbuildinfo.server
.worktrees/

# Agent scratch — feature-matrix artifacts, viz scripts, local .venv. Machine-local,
# never tracked and never in the Docker build context.
agent-scratch/
# Agent-generated architecture visualization (docs/master-diagram). Machine-local, never committed.
docs/master-diagram/
