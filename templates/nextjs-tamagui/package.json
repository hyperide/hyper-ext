{
  "name": "nextjs-tamagui",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "scripts": {
    "dev": "yarn build && cd apps/next && yarn dev",
    "native": "cd apps/expo && yarn start",
    "native:prebuild": "cd apps/expo && yarn prebuild",
    "ios": "cd apps/expo && yarn ios",
    "android": "cd apps/expo && yarn android",
    "watch": "ultra -r --no-pretty --concurrency 400 watch",
    "vercel:install": "yarn set version 3.5 && yarn install",
    "web": "yarn build && cd apps/next && yarn dev",
    "web:extract": "DISABLE_EXTRACTION=false yarn workspace next-app dev",
    "web:prod": "yarn workspace next-app build",
    "web:prod:serve": "yarn workspace next-app serve",
    "postinstall": "yarn check-tamagui && yarn build",
    "build": "yarn workspaces foreach --all --exclude next-app run build",
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "check-tamagui": "tamagui check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.6",
    "@tamagui/cli": "^1.144.1",
    "@tamagui/react-native-svg": "^1.144.1",
    "@tamagui/react-native-web-lite": "^1.144.1",
    "check-dependency-version-consistency": "^4.1.0",
    "husky": "^9.1.6",
    "turbo": "^2.9.14",
    "typescript": "~5.8.3",
    "ultra-runner": "^3.10.5",
    "vitest": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3"
  },
  "resolutions": {
    "@babel/core": ">=7.29.6 <8",
    "@babel/helpers": ">=7.26.10 <8",
    "@babel/runtime": ">=7.26.10 <8",
    "@isaacs/brace-expansion": ">=5.0.6",
    "@tootallnate/once": ">=3.0.1",
    "@xmldom/xmldom": ">=0.8.13 <0.9.0",
    "ajv": ">=8.18.0",
    "brace-expansion": ">=5.0.6",
    "diff": ">=4.0.4",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.2",
    "glob": ">=10.5.0",
    "image-size": ">=1.2.1",
    "ip-address": ">=10.1.1 <11",
    "js-yaml": ">=4.2.0 <5",
    "lodash": ">=4.18.1",
    "minimatch": ">=9.0.6",
    "nanoid": "^3.3.17",
    "next": ">=16.2.7",
    "node-forge": ">=1.4.0",
    "on-headers": ">=1.1.0",
    "path-to-regexp@npm:0.1.12": "0.1.13",
    "path-to-regexp@npm:6.1.0": "6.3.0",
    "picomatch": ">=4.0.4",
    "piscina": "4.9.3",
    "postcss": ">=8.5.10",
    "qs": ">=6.15.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "0.21.2",
    "react-refresh": "^0.14.0",
    "shell-quote": ">=1.8.4",
    "tar": ">=7.5.16 <8",
    "tmp": ">=0.2.6",
    "undici": ">=7.28.0 <8",
    "uuid": ">=11.1.1 <12",
    "vite": ">=7.3.2 <8",
    "ws@npm:^8.0.0": ">=8.20.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.5.0"
}
