{
  "name": "hypercanvas-preview",
  "displayName": "HyperIDE",
  "version": "0.1.66",
  "description": "Visual editor for React components",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "component-editor",
    "preview",
    "react",
    "react-native",
    "tailwind",
    "tamagui",
    "visual-editor"
  ],
  "homepage": "https://hyperide.ai",
  "bugs": {
    "url": "https://github.com/hyperide/hyper-ext/issues"
  },
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperide/hyper-ext"
  },
  "publisher": "hyperide",
  "main": "./out/extension.js",
  "scripts": {
    "preinstall": "node scripts/assert-npm.mjs",
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production && node scripts/check-webview-bundles.mjs && tailwindcss --input src/webview/styles.css --output out/webview.css --minify",
    "check:webview-bundles": "node scripts/check-webview-bundles.mjs",
    "build:css": "tailwindcss --input src/webview/styles.css --output out/webview.css --minify",
    "watch": "node esbuild.js --watch & tailwindcss --input src/webview/styles.css --output out/webview.css --watch",
    "compile": "tsc -p ./",
    "test": "bun test --isolate src/",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sentry/node": "^10",
    "html2canvas": "^1.4.1",
    "posthog-node": "^5",
    "react-resizable-panels": "^4.6.5",
    "recast": "^0.23.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tabler/icons-react": "^3.28.1",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "zustand": "^5.0.2"
  },
  "resolutions": {
    "fast-uri": ">=3.1.2",
    "hono": ">=4.12.25",
    "lodash": ">=4.18.0",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "tmp": ">=0.2.6"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.13",
    "fast-uri": "^3.1.2",
    "form-data": ">=4.0.6",
    "hono": ">=4.12.25",
    "ip-address": ">=10.1.1",
    "js-yaml": "^4.2.0",
    "lodash": ">=4.18.0",
    "markdown-it": "^14.2.0",
    "path-to-regexp": "^8.4.0",
    "picomatch": ">=4.0.4",
    "tmp": ">=0.2.6",
    "undici": "^7.28.0",
    "uuid": "^11.1.1"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "hypercanvas.mcpServer",
        "label": "HyperCanvas MCP"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypercanvas-explorer",
          "title": "HyperIDE",
          "icon": "media/preview.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "hypercanvas-inspector",
          "title": "HyperIDE",
          "icon": "media/preview.svg"
        }
      ],
      "panel": [
        {
          "id": "hypercanvas-preview-container",
          "title": "Hyper Logs",
          "icon": "media/preview.svg"
        }
      ]
    },
    "views": {
      "hypercanvas-explorer": [
        {
          "type": "webview",
          "id": "hypercanvas.explorerView",
          "name": "Explorer"
        }
      ],
      "hypercanvas-inspector": [
        {
          "type": "webview",
          "id": "hypercanvas.inspectorView",
          "name": "Inspector"
        },
        {
          "type": "webview",
          "id": "hypercanvas.aiChatView",
          "name": "AI Chat",
          "visibility": "collapsed"
        }
      ],
      "hypercanvas-preview-container": [
        {
          "type": "webview",
          "id": "hypercanvas.logsView",
          "name": "Logs",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "hypercanvas.openPreview",
        "title": "Hyper: Open Preview"
      },
      {
        "command": "hypercanvas.toggleCodeCanvasLayout",
        "title": "Hyper: Toggle Code/Canvas Layout"
      },
      {
        "command": "hypercanvas.refreshPreview",
        "title": "Hyper: Refresh Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "hypercanvas.closePreview",
        "title": "Hyper: Close Preview"
      },
      {
        "command": "hypercanvas.goToVisual",
        "title": "Hyper: Go to Visual"
      },
      {
        "command": "hypercanvas.previewAsApp",
        "title": "Hyper: Preview as App"
      },
      {
        "command": "hypercanvas.resetPreviewToAppShell",
        "title": "Hyper: Reset Preview to App Shell"
      },
      {
        "command": "hypercanvas.startDevServer",
        "title": "Hyper: Start Dev Server"
      },
      {
        "command": "hypercanvas.stopDevServer",
        "title": "Hyper: Stop Dev Server"
      },
      {
        "command": "hypercanvas.showDevServerOutput",
        "title": "Hyper: Show Dev Server Output"
      },
      {
        "command": "hypercanvas.generatePreviewWrapper",
        "title": "Hyper: Generate Preview Wrapper (.hyperide/preview.tsx)"
      },
      {
        "command": "hypercanvas.configureAIKey",
        "title": "Hyper: Configure AI API Key"
      },
      {
        "command": "hypercanvas.openLogs",
        "title": "Hyper: Open Logs"
      },
      {
        "command": "hypercanvas.clearDiagnostics",
        "title": "Hyper: Clear Diagnostics"
      },
      {
        "command": "hypercanvas.openAIChat",
        "title": "Hyper: Open AI Chat"
      },
      {
        "command": "hypercanvas.openExplorer",
        "title": "Hyper: Open Explorer"
      },
      {
        "command": "hypercanvas.openInspector",
        "title": "Hyper: Open Inspector"
      },
      {
        "command": "hypercanvas.openProjectStructure",
        "title": "Hyper: Open Project Structure Config"
      },
      {
        "command": "hypercanvas.setupMcp",
        "title": "Hyper: Setup MCP for AI Agents"
      },
      {
        "command": "hypercanvas.canvasUndo",
        "title": "Hyper: Undo Canvas Operation"
      },
      {
        "command": "hypercanvas.canvasRedo",
        "title": "Hyper: Redo Canvas Operation"
      },
      {
        "command": "hypercanvas.canvasDelete",
        "title": "Hyper: Delete Selected Elements"
      },
      {
        "command": "hypercanvas.canvasDuplicate",
        "title": "Hyper: Duplicate Selected Element"
      },
      {
        "command": "hypercanvas.canvasWrap",
        "title": "Hyper: Wrap Selected Element"
      },
      {
        "command": "hypercanvas.canvasInsertElement",
        "title": "Hyper: Insert Element"
      },
      {
        "command": "hypercanvas.canvasSelectChildren",
        "title": "Hyper: Select Children"
      },
      {
        "command": "hypercanvas.canvasSelectParent",
        "title": "Hyper: Select Parent"
      },
      {
        "command": "hypercanvas.canvasSelectNextSibling",
        "title": "Hyper: Select Next Sibling"
      },
      {
        "command": "hypercanvas.canvasSelectPrevSibling",
        "title": "Hyper: Select Previous Sibling"
      },
      {
        "command": "hypercanvas.canvasEscape",
        "title": "Hyper: Clear Selection"
      },
      {
        "command": "hypercanvas.canvasGoToCode",
        "title": "Hyper: Go to Code"
      },
      {
        "command": "hypercanvas.startDiagnosticCapture",
        "title": "Hyper: Start Diagnostic Capture"
      },
      {
        "command": "hypercanvas.stopDiagnosticCapture",
        "title": "Hyper: Stop Diagnostic Capture"
      }
    ],
    "keybindings": [
      {
        "command": "hypercanvas.goToVisual",
        "key": "cmd+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      },
      {
        "command": "hypercanvas.canvasUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' || focusedView == 'hypercanvas.inspectorView' || focusedView == 'hypercanvas.explorerView'"
      },
      {
        "command": "hypercanvas.canvasRedo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' || focusedView == 'hypercanvas.inspectorView' || focusedView == 'hypercanvas.explorerView'"
      },
      {
        "command": "workbench.action.files.saveAll",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel'"
      },
      {
        "command": "hypercanvas.canvasDelete",
        "key": "backspace",
        "mac": "backspace",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasDelete",
        "key": "delete",
        "mac": "delete",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasSelectChildren",
        "key": "enter",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasSelectParent",
        "key": "shift+enter",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasSelectNextSibling",
        "key": "tab",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasSelectPrevSibling",
        "key": "shift+tab",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasEscape",
        "key": "escape",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasDuplicate",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      },
      {
        "command": "hypercanvas.canvasGoToCode",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "activeWebviewPanelId == 'hypercanvas.previewPanel' && !inputFocus && !hypercanvas.rightPanelInputFocused"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hypercanvas.refreshPreview",
          "when": "activeWebviewPanelId == 'hypercanvas.previewPanel'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "hypercanvas.goToVisual",
          "group": "navigation",
          "when": "editorTextFocus && resourceExtname =~ /\\.(tsx|jsx)$/"
        },
        {
          "command": "hypercanvas.previewAsApp",
          "group": "navigation",
          "when": "editorTextFocus && resourceExtname =~ /\\.(tsx|jsx)$/"
        }
      ]
    },
    "configuration": {
      "title": "HyperIDE",
      "properties": {
        "hypercanvas.ai.provider": {
          "type": "string",
          "enum": [
            "claude",
            "openai",
            "glm",
            "firepass",
            "commandcode",
            "proxy",
            "opencode"
          ],
          "default": "glm",
          "enumDescriptions": [
            "Anthropic Claude",
            "OpenAI or compatible",
            "GLM (Z.ai)",
            "Fire Pass (Fireworks AI) — Kimi K2.6 Turbo flat-rate, other Fireworks models per-token",
            "Command Code — credit-based access to DeepSeek V4 Pro, Qwen, Kimi, MiniMax, Claude, GPT-5 and more",
            "Multi-provider proxy (Gemini, DeepSeek, Mistral, Groq)",
            "OpenCode native SDK (Gemini, DeepSeek, Qwen)"
          ],
          "markdownDescription": "AI provider. To set API key, run **Hyper: Configure AI API Key** (Ctrl+Shift+P). Recommended: GLM via Z.ai — flat-rate from $10/mo.",
          "description": "AI provider for project structure analysis"
        },
        "hypercanvas.ai.backend": {
          "type": "string",
          "enum": [
            "gemini",
            "google",
            "openai",
            "anthropic",
            "deepseek",
            "mistral",
            "groq",
            "qwen"
          ],
          "description": "Backend key type for proxy/opencode providers (e.g. 'gemini', 'anthropic', 'deepseek'). Not needed for claude, glm, firepass, commandcode, or openai providers."
        },
        "hypercanvas.ai.model": {
          "type": "string",
          "description": "Model identifier (e.g. claude-sonnet-4-20250514, gpt-4o, gemini/gemini-2.5-pro)"
        },
        "hypercanvas.ai.baseURL": {
          "type": "string",
          "description": "Custom base URL for AI provider API (optional)"
        },
        "hypercanvas.devServer.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start dev server when opening preview"
        },
        "hypercanvas.preview.defaultPort": {
          "type": "number",
          "default": 3000,
          "description": "Default port for dev server (will use next available if busy)"
        },
        "hypercanvas.preview.syncPositions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync cursor position in code with element highlight in preview and vice versa"
        },
        "hypercanvas.preview.autoSampleGeneration": {
          "type": "boolean",
          "default": true,
          "description": "Auto-generate a SampleDefault export in component files (for preview wrapping). Disable for E2E test harnesses that reset source files between runs — the export drop would trigger Vite 'export removed' errors and full reloads."
        },
        "hypercanvas.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "markdownDescription": "Enable anonymous usage and error telemetry. This is **always AND-ed with VS Code's global `telemetry.telemetryLevel`** — if VS Code telemetry is off, nothing is sent regardless of this setting. No source code, file paths, prompts, or personal data are ever transmitted (only enums, counts, durations, and hashes). Set to `false` to opt out of HyperIDE telemetry specifically."
        },
        "hypercanvas.telemetry.posthogKey": {
          "type": "string",
          "default": "",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "markdownDescription": "PostHog project API key for product analytics. Leave empty to disable the PostHog path entirely. Falls back to the `HYPERCANVAS_POSTHOG_KEY` environment variable when unset. Never commit a key here."
        },
        "hypercanvas.telemetry.posthogHost": {
          "type": "string",
          "default": "https://eu.i.posthog.com",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "markdownDescription": "PostHog ingestion host (EU region by default). Falls back to the `HYPERCANVAS_POSTHOG_HOST` environment variable when unset."
        },
        "hypercanvas.telemetry.sentryDsn": {
          "type": "string",
          "default": "",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "markdownDescription": "Sentry DSN (EU project) for error reporting. Leave empty to disable the Sentry path. Falls back to the `HYPERCANVAS_SENTRY_DSN` environment variable when unset."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  }
}
