{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Server (Bun) has no DOM. Removing DOM lib allows UseLibDomIfAvailable
    // in bun-types to use Bun's own WebSocket type (including headers option),
    // rather than falling back to the DOM WebSocket constructor.
    "lib": ["ES2022"],
    "tsBuildInfoFile": "./.tsbuildinfo.server"
  },
  "include": ["server/**/*"]
}
